# Clés VAPID (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://cogitobe.vercel.app

# Upstash Redis (console Upstash > ta base > REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secrets (openssl rand -hex 32)
CRON_SECRET=
STATS_SECRET=

# Alertes mail tous les 1000 inscrits (resend.com)
RESEND_API_KEY=
ALERT_EMAIL=
# Facultatif
# MAX_SUBSCRIBERS=8000
# ALERT_FROM=COGITOBE <alertes@ton-domaine.fr>
